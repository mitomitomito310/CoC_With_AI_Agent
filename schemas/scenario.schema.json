{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"scenario.schema.json","type":"object","additionalProperties":false,
  "required":["schema_version","scenario_id","title","rules_profile","status","source","opening","actors","secrecy","state_version","updated_at"],
  "properties":{
    "schema_version":{"const":"1.0"},"scenario_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9_-]{2,63}$"},"title":{"type":"string","minLength":1},
    "rules_profile":{"type":"string","minLength":1},
    "status":{"enum":["importing","preparing","blocked","ready","active","paused","completed","archived"]},
    "status_reason":{"type":"string"},"blocking_issues":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "source":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["path","sha256","media_type","immutable"],"properties":{"path":{"type":"string","pattern":"^source/"},"sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"media_type":{"enum":["text/plain","text/markdown"]},"immutable":{"const":true}}}},
    "opening":{"type":"object","additionalProperties":false,"required":["scene_id","location","participants"],"properties":{"scene_id":{"type":"string","minLength":1},"location":{"type":"string","minLength":1},"participants":{"type":"array","items":{"type":"string"},"minItems":1}}},
    "actors":{"type":"array","minItems":1,"items":{"type":"object","required":["id","role"],"properties":{"id":{"type":"string"},"role":{"enum":["player","npc","keeper"]}}}},
    "secrecy":{"type":"object","required":["classified","public_import_report"],"properties":{"classified":{"type":"boolean"},"public_import_report":{"enum":["ready","blocked","unreadable"]}}},
    "current_scene_id":{"type":["string","null"]},"last_checkpoint_id":{"type":["string","null"]},"state_version":{"type":"integer","minimum":0},"updated_at":{"type":"string","format":"date-time"}
  }
}
